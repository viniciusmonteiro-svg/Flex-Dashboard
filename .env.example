# Copy this file to .env.local and fill in your actual path.
# Never commit .env.local — it is gitignored.

# Full path to the local Google Drive folder containing the source data files.
# This is the folder synced by Google Drive for Desktop — no API required.
# Use backslashes on Windows. No quotes, no trailing slash.
#
# Example (your actual path will go here):
SOURCE_DATA_PATH=G:\.shortcut-targets-by-id\<GUID>\FP&A\Vinicius - FP&A\Marketing Report\Marketing Dashboard
