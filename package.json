{
  "name": "marketing-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check-source": "tsx scripts/check-source.ts",
    "ingest": "npx tsx --tsconfig tsconfig.scripts.json scripts/ingest.ts",
    "ingest:preview": "npx tsx --tsconfig tsconfig.scripts.json scripts/ingest.ts --preview",
    "ingest:force": "npx tsx --tsconfig tsconfig.scripts.json scripts/ingest.ts --force",
    "reset": "npx tsx --tsconfig tsconfig.scripts.json scripts/reset.ts",
    "reset:ingest": "npx tsx --tsconfig tsconfig.scripts.json scripts/reset.ts && npx tsx --tsconfig tsconfig.scripts.json scripts/ingest.ts",
    "rebuild": "npx tsx --tsconfig tsconfig.scripts.json scripts/rebuild.ts",
    "ship": "git add -A && git commit -m \"update\" && git push && npx vercel deploy --prod"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.6",
    "@tanstack/react-table": "^8.21.3",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "googleapis": "^171.4.0",
    "next": "^16.2.6",
    "papaparse": "^5.5.3",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^2.15.4",
    "svix": "^1.93.0",
    "tailwind-merge": "^2.6.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vitest": "^1.6.1"
  }
}
